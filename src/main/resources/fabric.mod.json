{
  "schemaVersion": 1,
  "id": "tropercraft-mod",
  "version": "${version}",
  "name": "TroperCraft-Mod",
  "description": "Patrullas de 3 a 5 stormtroopers con blásteres láser y sonidos originales por todo el Overworld, incluidas las cuevas.",
  "authors": [
    "TroperCraft"
  ],
  "license": "CC0-1.0",
  "icon": "assets/tropercraft-mod/icon.png",
  "environment": "*",
  "mixins": [
    "tropercraft-mod.mixins.json",
    "tropercraft-mod.client.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.tunombre.stormcraft.TroperCraftMod"
    ],
    "client": [
      "com.tunombre.stormcraft.client.TroperCraftClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
